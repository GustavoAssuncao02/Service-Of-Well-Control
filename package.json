{
  "name": "service-of-wellcontrol",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema web para gestao de cursos na area de petroleo",
  "main": "backend/src/server.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "postinstall": "npm run build",
    "install:all": "npm install --workspaces",
    "start": "npm start --workspace backend",
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "server": "npm run dev --workspace backend",
    "client": "npm run dev --workspace frontend",
    "db:init": "npm run db:init --workspace backend",
    "build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
